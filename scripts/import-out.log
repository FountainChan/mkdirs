fetchItem, url: https://backlinkgpt.com/en mergedData: {
  link: 'https://backlinkgpt.com/en',
  name: 'backlinkgpt',
  description: 'BacklinkGPT is an AI-powered link building agent that scans SERPs, evaluates backlink prospects, discovers contacts, and automates personalized outreach.',
  introduction: 'BacklinkGPT is an AI agent designed to automate the entire link-building process for SEO professionals, marketing teams, and website owners. By simply providing a domain, BacklinkGPT analyzes target pages, sweeps search engine result pages (SERPs) and competitor backlink profiles, evaluates prospect relevance, and identifies key decision-makers to run targeted outreach.\n' +
    '\n' +
