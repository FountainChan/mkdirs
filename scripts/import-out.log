fetchItem, url: https://www.brainfishai.com mergedData: {
  link: 'https://www.brainfishai.com',
  name: 'brainfish',
  description: 'Brainfish provides AI-powered support agents for B2B businesses to resolve complex support tickets with high accuracy and zero training on customer data.',
  introduction: '## Overview\n' +
    'Brainfish is an enterprise-grade AI support platform designed to handle complex B2B customer support queries. By integrating directly into existing product knowledge bases, documentation, and customer service platforms, Brainfish deploys intelligent AI agents that accurately answer support tickets across multiple channels without relying on engineering resources.\n' +
    '\n' +
    '### Key Features\n' +
    '- **Multi-Channel AI Agents**: Resolves tickets directly across Slack, Zendesk, Intercom, Microsoft Teams, and in-product chat interfaces.\n' +
    '- **Knowledge Base Integration**: Connects with Notion, Google Drive, ReadMe, and internal repositories to ground responses in real product knowledge.\n' +
    '- **Role & Account Context Personalization**: Tailors answers based on user roles, subscription plans, regions, and account health.\n' +
    '- **Performance Evaluation & Refinement**: Includes an Answer Inspector and detailed analytics to track resolution rates, identify content gaps, and improve agent responses.\n' +
    '- **Enterprise Security & Privacy**: Offers SOC 2 Type II compliance, GDPR compliance, regional data residency (US/EU/AU), and strict policies against training models on customer data.\n' +
    '\n' +
    '### Use Cases\n' +
    '- **Complex L2 Customer Support**: Automating multi-step troubleshooting and query handling for SaaS and technical B2B platforms.\n' +
    '- **Internal AI Support Copilot**: Empowering internal support reps with fast context retrieval and draft answers.\n' +
    '- **Self-Serve Support Deflection**: Lowering ticket volumes by answering routine and semi-complex user queries self-service style.',
  categories: [ 'AI Tools', 'AI Chat' ],
  tags: [ 'AI', 'Chatbot', 'Automation', 'Productivity' ],
  image: 'https://www.brainfishai.com/og-default.png',
  icon: 'https://icons.duckduckgo.com/ip3/www.brainfishai.com.ico'
}
