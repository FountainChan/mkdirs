  icon: 'https://icons.duckduckgo.com/ip3/namelix.com.ico'
}
fetchItem, url: https://nanonets.com mergedData: {
  link: 'https://nanonets.com',
  name: 'nanonets',
  description: 'Nanonets 是一家企业级 AI 数据处理与文档智能提取平台，利用 AI Agent 自动化处理发票、订单及复杂文档数据流。',
  introduction: '### 简介\n' +
    'Nanonets 是一家面向企业级数据处理与文档智能管理的 AI 自动化平台。通过先进的 AI Agent 与自研的 Nanonets OCR-3 模型，Nanonets 能够准确提取非结构化文档（如发票、采购单、提货单及合同等）中的数据，并无缝对接 SAP、Salesforce 等主流 ERP 与 CRM 系统。\n' +
    '\n' +
    '### 核心功能\n' +
    '- **智能文档数据提取**：支持任意格式的文档识别与表格提取，精准解析复杂结构与字段。\n' +
    '- **Context Graph（上下文图谱）**：结合企业业务逻辑与 SOP，缝合多系统上下文，高效处理边缘复杂用例。\n' +
    '- **AI Agent 工作流**：将标准作业程序转化为可端到端自动执行的 AI Agent，显著减少人工数据录入。\n' +
    '- **无缝生态集成**：深度对接 SAP、QuickBooks、Salesforce、Google Drive、Slack 等数十种企业工具。\n' +
    '- **企业级安全管控**：通过 SOC 2 Type II、GDPR、ISO 27001 及 HIPAA 认证，支持私有化部署、单点登录（SSO）与完整审计日志。\n' +
    '\n' +
    '### 适用场景\n' +
    '- **应付账款与财务自动化**：自动解析发票并匹配采购单，实现无感入账。\n' +
    '- **订单及物流管理**：快速处理客户订单与物流单据，提升供应链响应速度。\n' +
    '- **理赔与医疗文档处理**：高效结构化提取保单与医疗记录数据。',
  categories: [ 'Data Tools', 'AI Tools', 'Office Tools' ],
  tags: [ 'Automation', 'AI', 'Productivity', 'Free Trial', 'No Code' ],
  image: undefined,
  icon: 'https://icons.duckduckgo.com/ip3/nanonets.com.ico'
}
