fetchItem, url: https://www.recall.it mergedData: {
  link: 'https://www.recall.it',
  name: 'recall',
  description: 'Recall 是一款个人 AI 知识库工具，可帮助用户一键保存、总结并整理文章、视频、播客及文档，并支持使用 ChatGPT、Claude 或 Gemini 等 AI 模型与积累的知识进行对话。',
  introduction: 'Recall 是一款结合人工智能技术的个人知识库工具，旨在帮助用户高效收集、整理和检索各种形式的信息。通过 Recall，用户可以轻松保存网页文章、YouTube 视频、播客、PDF 文件及个人笔记，并利用 AI 快速提炼摘要。\\n\\n### 主要功能\\n- **全平台剪藏**：提供 Chrome、Safari、Edge、Firefox 扩展及 iOS/Android 应用，支持一键保存各种类型的内容。\\n- **AI 智能摘要**：自动为长视频、音频播客和长篇文章生成精简摘要，支持将数小时的内容缩短至几分钟了解。\\n- **自动标签与知识连接**：内置智能标签系统，能自动关联相关概念，形成有机的知识图谱。\\n- **多模型 AI 对话**：允许用户使用 ChatGPT、Claude、Gemini 等主流大模型对个人知识库进行提问和交互。\\n- **间隔重复与 AI 测验**：根据保存的内容自动生成测验，利用间隔重复算法帮助强化记忆。\\n\\n### 适用场景\\n- **知识工作者与研究人员**：快速整理分析大量文献、行业报告与技术视频。\\n- **学生与终身学习者**：建立结构化的个人学习库，通过 AI 测验巩固知识。\\n- **信息流重度用户**：高效管理日常阅读与视听资源，避免信息过载。',
  categories: [ 'AI Tools', 'Office Tools', 'Search and Research' ],
  tags: [ 'AI', 'Productivity', 'Chatbot', 'Audio', 'Video' ],
  image: 'https://www.recall.it/images/recall-ai-knowledge-base-og-preview.webp',
  icon: 'https://icons.duckduckgo.com/ip3/www.recall.it.ico'
}
