  link: 'https://summify.io',
  name: 'summify',
  description: 'Summify is an AI-powered knowledge layer that transcribes, summarizes, and indexes videos, podcasts, and docs into usable knowledge pods for AI tools.',
  introduction: '## Overview\n' +
