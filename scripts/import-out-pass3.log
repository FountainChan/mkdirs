fetchItem, url: https://www.spellbook.com mergedData: {
  link: 'https://www.spellbook.com',
  name: 'spellbook',
  description: 'AI contract review and drafting platform for legal teams, working directly in Microsoft Word.',
  introduction: '## Spellbook: AI-Powered Contract Intelligence\n' +
    '\n' +
    'Spellbook is a leading AI contract review and drafting platform designed for transactional lawyers. It integrates directly into Microsoft Word, leveraging advanced language models like GPT-5 and Claude to help legal teams draft and review contracts with significantly greater speed and precision.\n' +
    '\n' +
    '### Key Features\n' +
    '\n' +
    "*   **AI Contract Review:** Automatically redlines contracts, flags risks, and identifies non-standard terms against your company's playbooks and industry standards.\n" +
    '*   **AI Drafting:** Draft clauses and full documents from scratch or from a library of your preferred precedents, all within your existing Word workflow.\n' +
    '*   **Ask (AI Q&A):** Get quick, cited answers to complex legal questions about your contract.\n' +
    '*   **Market Comparison:** Benchmarks your contracts against thousands of similar agreements in the market.\n' +
    '*   **Associate Agent:** An AI agent for complex, multi-document drafting and review workflows.\n' +
    '*   **Enterprise Security:** Built for legal-grade confidentiality with SOC 2 Type II, HIPAA, GDPR compliance, and zero data retention by LLM providers.\n' +
    '\n' +
    '### Target Users & Use Cases\n' +
    '\n' +
    '*   **In-House Legal Teams:** Used by companies like Dropbox, eBay, and Panasonic to bring more work in-house, maintain consistency with playbooks, and accelerate review cycles.\n' +
    '*   **Law Firms:** Firms like Kennedys and Westaway use Spellbook to reduce time on repetitive drafting, improve billing efficiency, and deliver faster service to clients.\n' +
    '*   **Industries:** Solutions are tailored for sectors including Energy, Healthcare, Financial Services, Technology, Manufacturing, and Retail & Consumer Goods.\n' +
    '\n' +
    'Spellbook serves over 4,500 legal teams in 80+ countries, positioning itself as an end-to-end contract intelligence system from intake to insight.',
  categories: [ 'Office Tools', 'AI Tools', 'Productivity' ],
  tags: [ 'AI', 'Productivity', 'Automation', 'Writing' ],
  image: 'https://cdn.prod.website-files.com/66fc4a00d70e086034b6699f/673fa3324b6c0b26078d4620_open-graph-screen.png',
  icon: 'https://icons.duckduckgo.com/ip3/www.spellbook.com.ico'
}
