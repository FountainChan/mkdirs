fetchItem, url: https://www.igpt.ai/chat mergedData: {
  link: 'https://www.igpt.ai/chat',
  name: 'igpt',
  description: 'iGPT chat is a personal AI built on your work context, connecting to email, docs, and meetings to provide trusted, sourced answers.',
  introduction: 'iGPT is an enterprise AI chat platform that creates a personalized assistant grounded in your actual work data. Unlike generic AI tools, it connects directly to your business ecosystem through secure OAuth integrations, analyzing email threads, document histories, calendar events, and meeting notes to understand the full context of your work.\n' +
    '\n' +
    '## Core Features\n' +
    '\n' +
    '- **Context-Aware Chat**: Ask questions about your work history and receive answers sourced directly from emails, documents, and meetings, with verifiable citations to eliminate hallucinations.\n' +
    '- **Personal Context Memory**: The AI remembers past conversations and learns from your ongoing work, allowing you to pick up where you left off without re-explaining context.\n' +
    '- **Unified Work Data**: Pulls information from connected tools (like Gmail, Google Drive, Slack) and enriches it with live web data to provide comprehensive answers.\n' +
    '- **Enterprise-Grade Security**: Offers zero data training (your data is never used to improve models), zero data retention (inferences are processed in memory), and role-based access control. Deployment options include Cloud, Hybrid (data stays on your VPC), and Fully Private (on-premises).\n' +
    '\n' +
    '## Primary Use Cases\n' +
    '\n' +
    '- **Daily Briefings**: Get personalized summaries of what happened since yesterday, upcoming deadlines, and emerging risks.\n' +
    '- **Meeting Preparation**: Automatically compile talking points, relevant attachments, and action items from past conversations before your next sync.\n' +
    '- **Research Synthesis**: Understand emerging themes, unanswered questions, and key insights from your gathered research and internal discussions.\n' +
    '- **Context-Aware Writing**: Draft emails, follow-ups, and documents using real conversation history and commitments as a foundation.\n' +
    '- **Work Organization**: Analyze current projects, prioritize tasks, and identify blockers or delays across your connected work streams.',
  categories: [ 'AI Chat', 'Office Tools', 'Productivity' ],
  tags: [ 'AI', 'Chatbot', 'Productivity', 'Automation' ],
  image: 'https://staging.igpt.website/wp-content/uploads/2026/04/igpt-og-image.png',
  icon: 'https://icons.duckduckgo.com/ip3/www.igpt.ai.ico'
}
